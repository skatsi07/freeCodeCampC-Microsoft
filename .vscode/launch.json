{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (Lesson2)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-lesson2",
            "program": "${workspaceFolder}/debuggingConsoleApplications/Lesson2/bin/Debug/net10.0/Lesson2.dll",
            "args": [],
            "cwd": "${workspaceFolder}/debuggingConsoleApplications/Lesson2",
            "console": "integratedTerminal",
            "stopAtEntry": false
        },
        {
            "name": ".NET Core Attach (Interactive Terminal)",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ]
}